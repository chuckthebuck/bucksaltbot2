{
  "name": "@chuckbot/chuck-salt-shack",
  "private": true,
  "version": "0.2.1",
  "description": "Codex frontend for Chuck the Salt Shack",
  "license": "MIT",
  "homepage": "https://github.com/chuckthebuck/chuck-the-salt-shack",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chuckthebuck/chuck-the-salt-shack.git"
  },
  "bugs": {
    "url": "https://github.com/chuckthebuck/chuck-the-salt-shack/issues"
  },
  "type": "module",
  "scripts": {
    "registry": "PYTHONPATH=modules python3 -m chuck_salt_shack.build",
    "registry:check": "PYTHONPATH=modules python3 -m chuck_salt_shack.build --check",
    "build": "npm run registry && vite build",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@wikimedia/codex": "^2.6.0",
    "@wikimedia/codex-design-tokens": "^2.6.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.0",
    "vue-tsc": "^3.0.0"
  }
}
