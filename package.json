{
  "name": "chuckbot-framework",
  "private": true,
  "version": "4.1.7",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "npm run modules:frontend && tsc && vite build",
    "modules:frontend": "node scripts/generate-module-frontend-registry.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint client-src --ext .ts,.vue",
    "test": "vitest run",
    "modules:update": "bash scripts/update-vendored-modules.sh",
    "modules:push:chuck-file-changer": "bash scripts/backport-chuck-file-changer-subtree.sh",
    "modules:push:chuck-file-changer:dry-run": "bash scripts/backport-chuck-file-changer-subtree.sh --dry-run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.63.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.9.2",
    "jsdom": "^30.0.0",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1"
  },
  "dependencies": {
    "vue": "^3.5.39",
    "@wikimedia/codex": "^2.6.0",
    "@wikimedia/codex-design-tokens": "^2.6.0",
    "less": "^4.6.7"
  }
}
